<style>
  /* ============================================
     GLOBAL: Font Smoothing
  ============================================ */
  body {
    text-rendering: optimizeLegibility !important;
    -webkit-font-smoothing: antialiased !important;
    -moz-osx-font-smoothing: grayscale !important;
  }

  /* ============================================
     CUSTOM CURSOR
  ============================================ */
  @media (hover: hover) and (pointer: fine) {
    [data-cursor] .cursor-bubble {
      transition:
        transform 0.1s cubic-bezier(0.625, 0.05, 0, 1),
        opacity 0.1s cubic-bezier(0.625, 0.05, 0, 1);
      transform: translateX(0%) scale(0) rotate(0.001deg);
    }

    [data-cursor="active"] .cursor-bubble {
      opacity: 1;
      transform: translateX(0%) scale(1) rotate(0.001deg);
    }

    [data-cursor="active-edge"] .cursor-bubble {
      opacity: 1;
      transform: translateX(-100%) scale(1) rotate(0.001deg);
    }

    [data-cursor-hover] {
      cursor: none;
    }
  }

  @media (hover: none) and (pointer: coarse) {
    .cursor {
      display: none;
    }
  }

  /* ============================================
     BUNNY BACKGROUND VIDEO PLAYER
  ============================================ */
  [data-bunny-background-init] :is(.bunny-bg__placeholder, .bunny-bg__loading) {
    transition:
      opacity 0.3s linear,
      visibility 0.3s linear;
  }

  /* Hide placeholder when video is playing, paused, or activated and ready */
  [data-bunny-background-init][data-player-status="playing"] .bunny-bg__placeholder,
  [data-bunny-background-init][data-player-status="paused"] .bunny-bg__placeholder,
  [data-bunny-background-init][data-player-activated="true"][data-player-status="ready"] .bunny-bg__placeholder {
    opacity: 0;
    visibility: hidden;
  }

  /* Toggle play/pause icons */
  [data-bunny-background-init][data-player-status="playing"] .bunny-bg__play-svg,
  [data-bunny-background-init][data-player-status="loading"] .bunny-bg__play-svg {
    display: none;
  }

  [data-bunny-background-init][data-player-status="playing"] .bunny-bg__pause-svg,
  [data-bunny-background-init][data-player-status="loading"] .bunny-bg__pause-svg {
    display: block;
  }

  /* Show loading indicator */
  [data-bunny-background-init][data-player-status="loading"] .bunny-bg__loading {
    opacity: 1;
    visibility: visible;
  }

  /* ============================================
     EVENT CARDS (shared transitions)
  ============================================ */
  .event-card_thumbnail, .artist-card_grow_wrapper {
    width: 100%;
    height: 100%;
    transition:
      width 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      height 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .thumbnail-marker_wrapper {
    opacity: 0.05;
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cl_slider_item {
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .artist-card .link-tag_list {
    opacity: 0;
    transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /*.artist-card:hover .link-tag_list {
    opacity: 1;
  }*/

  /* Tablet and up: hover-driven effects (horizontal events slider + standalone cards) */
  @media (min-width: 768px) {
    .event-card:hover .event-card_thumbnail {
      width: calc(100% - 1em);
      height: calc(100% - 1em);
    }

    /*.artist-card:hover .artist-card_grow_wrapper {
      width: calc(100% - 1em);
      height: calc(100% - 1em);
    }*/

    .event-card:hover .thumbnail-marker_wrapper {
      opacity: 1;
    }

    .artist-card:hover .thumbnail-marker_wrapper {
      opacity: 1;
    }

    /* Fade non-hovered cards in horizontal events slider */
    [data-events-swiper].cl_slider_wrapper:hover .cl_slider_item {
      opacity: 0.2;
    }

    [data-events-swiper].cl_slider_wrapper:hover .cl_slider_item:hover {
      opacity: 1;
    }
  }

  /* Mobile: auto-apply effect to active slide (horizontal events + lineup) */
  @media (max-width: 767px) {
    .swiper-slide-active .event-card_thumbnail,
    .swiper-slide-active .artist-card_grow_wrapper {
      width: calc(100% - 1em);
      height: calc(100% - 1em);
    }

    .swiper-slide-active .thumbnail-marker_wrapper {
      opacity: 1;
    }
  }

  /* ============================================
     LINEUP SWIPER — center card is active state
  ============================================ */
  [data-lineup-swiper] .cl_slider_item {
    opacity: 0.2;
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  [data-lineup-swiper] .cl_slider_item.swiper-slide-active {
    opacity: 1;
  }

  /* Active card: grow effect, marker, and link tags visible */
  [data-lineup-swiper] .swiper-slide-active .artist-card_grow_wrapper {
    width: calc(100% - 1em);
    height: calc(100% - 1em);
  }

  [data-lineup-swiper] .swiper-slide-active .thumbnail-marker_wrapper {
    opacity: 1;
  }

  [data-lineup-swiper] .swiper-slide-active .artist-card .link-tag_list,
  [data-lineup-swiper] .swiper-slide-active .link-tag_list {
    opacity: 1;
  }

  /* Active card: label expands from 0 to auto height */
  [data-lineup-swiper] .artist-card_label_wrapper {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 0.5s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  [data-lineup-swiper] .artist-card_label_wrapper > * {
    min-height: 0;
    overflow: hidden;
  }

  [data-lineup-swiper] .swiper-slide-active .artist-card_label_wrapper {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  /* ============================================
     EVENTS SWIPER VERTICAL — center card is active state
  ============================================ */
  [data-events-swiper-vertical] .cl_events_item {
    opacity: 0.2;
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  [data-events-swiper-vertical] .cl_events_item.swiper-slide-active {
    opacity: 1;
  }

  /* Default thumbnail size + transition */
  [data-events-swiper-vertical] .event-card_thumbnail,
  [data-events-swiper-vertical] .artist-card_grow_wrapper {
    width: 100%;
    height: 100%;
    transition:
      width 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      height 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Active card: thumbnail shrinks */
  [data-events-swiper-vertical] .swiper-slide-active .event-card_thumbnail {
    width: calc(100% - 1em);
    height: calc(100% - 1em);
  }

  /* Active card: corner markers visible */
  [data-events-swiper-vertical] .swiper-slide-active .thumbnail-marker_wrapper {
    opacity: 1;
  }

  /* ============================================
     PRODUCT CARDS (Swiper Slider)
  ============================================ */
  .product-card_description {
    display: grid;
    grid-template-rows: 0fr;
  }

  .product-card_description > * {
    min-height: 0;
  }

  .product-card_drawer-line.is-2 {
    transform: rotate(90deg);
  }

  /* Desktop: hover-driven expand/collapse */
  @media (min-width: 992px) {
    .product-card_description {
      transition: grid-template-rows 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .product-card:hover .product-card_description {
      grid-template-rows: 1fr;
    }

    .product-card:hover .product-card_drawer-line.is-2 {
      transform: rotate(0deg);
    }

    .product-card:hover .product-card_thumbnail_main {
      opacity: 0;
    }

    /* Fade non-hovered cards in product slider */
    [data-products-swiper].cl_slider_wrapper:hover .cl_slider_item {
      opacity: 0.2;
    }

    [data-products-swiper].cl_slider_wrapper:hover .cl_slider_item:hover {
      opacity: 1;
    }

    /* Fade non-hovered cards in horizontal events wrapper */
    [data-events-swiper].cl_events_wrapper:hover .cl_events_item {
      opacity: 0.2;
    }

    [data-events-swiper].cl_events_wrapper:hover .cl_events_item:hover {
      opacity: 1;
    }
  }

  /* Respect reduced motion preferences */
  @media (prefers-reduced-motion: reduce) {
    .product-card_description,
    .product-card_drawer-line.is-2,
    .product-card_thumbnail_main {
      transition: none;
    }
  }

  /* ============================================
     FOOTER ACCORDION
  ============================================ */
  .footer_links_header.is-open .accordion_line.is-2 {
    transform: rotate(0deg);
  }

  /* ============================================
     SOUNDWAVE PAGINATION
  ============================================ */
  .swiper_pagination {
    display: flex;
    align-items: end;
    justify-content: center;
    gap: 0.3125em;
    height: 1.25em;
  }

  .swiper_pagination .swiper-pagination-bullet {
    width: 1px;
    opacity: 0.4 !important;
    background-color: currentColor;
    border-radius: 0;
    margin: 0 !important;
    transition: height 0.3s ease, opacity 0.3s ease;
    flex-shrink: 0;
  }

  .swiper_pagination .swiper-pagination-bullet:nth-child(5n + 1) { height: 0.875em; }
  .swiper_pagination .swiper-pagination-bullet:nth-child(5n + 2) { height: 1.125em; }
  .swiper_pagination .swiper-pagination-bullet:nth-child(5n + 3) { height: 0.625em; }
  .swiper_pagination .swiper-pagination-bullet:nth-child(5n + 4) { height: 1em; }
  .swiper_pagination .swiper-pagination-bullet:nth-child(5n + 5) { height: 0.75em; }

  .swiper_pagination .swiper-pagination-bullet-active {
    height: 1.25em !important;
    opacity: 1 !important;
  }
  
  [data-filter-component] {
  	display: none;
  }
</style>

