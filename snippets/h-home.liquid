  #globe-container {
    width: 100%;
    max-width: 35em;
    margin: 0 auto;
    font-family: 'JetBrains Mono', 'SF Mono', 'Fira Code', monospace;
    position: relative;
    touch-action: pan-y !important;
  }
  #globe-canvas-wrap {
    width: 100%;
    aspect-ratio: 1;
    margin: 0 auto;
    cursor: grab;
    position: relative;
    touch-action: pan-y !important;
    background: #324E44;   /* deep green box; only the sphere reads yellow */
  }
  #globe-canvas-wrap.grabbing {
    cursor: grabbing;
  }
  #globe-canvas-wrap canvas {
    display: block;
    width: 100%;
    height: 100%;
    touch-action: pan-y !important;
  }

  /* 1px outline — width/height/top/left dynamisch via JS op 96.1% */
  #globe-outline {
    position: absolute;
    border: 1px solid #0A0A0A;
    border-radius: 50%;
    pointer-events: none;
  }

  #globe-canvas-wrap::before,
  #globe-canvas-wrap::after {
    content: '';
    position: absolute;
    width: 0.5em;
    height: 0.5em;
    border-color: #0A0A0A;
    border-style: solid;
    border-width: 0;
    pointer-events: none;
    z-index: 5;
  }
  #globe-canvas-wrap::before {
    top: 0;
    right: 0;
    border-top-width: 1px;
    border-right-width: 1px;
  }
  #globe-canvas-wrap::after {
    bottom: 0;
    left: 0;
    border-bottom-width: 1px;
    border-left-width: 1px;
  }
</style>
