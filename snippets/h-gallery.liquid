      height: calc(100% - 1em);
    }

    /*.artist-card:hover .artist-card_grow_wrapper {
      width: calc(100% - 1em);
      height: calc(100% - 1em);
    }*/

    .event-card:hover .thumbnail-marker_wrapper {
      opacity: 1;
    }

    .artist-card:hover .thumbnail-marker_wrapper {
      opacity: 1;
    }

    /* Fade non-hovered cards in horizontal events slider */
    [data-events-swiper].cl_slider_wrapper:hover .cl_slider_item {
      opacity: 0.2;
    }

    [data-events-swiper].cl_slider_wrapper:hover .cl_slider_item:hover {
      opacity: 1;
    }
  }

  /* Mobile: auto-apply effect to active slide (horizontal events + lineup) */
  @media (max-width: 767px) {
    .swiper-slide-active .event-card_thumbnail,
    .swiper-slide-active .artist-card_grow_wrapper {
      width: calc(100% - 1em);
