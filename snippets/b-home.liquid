</style>
<script id="brk-footer-accordion-js">
(function(){
  var MQ = window.matchMedia('(max-width:991px)');

  // The footer is injected - and re-injected - by the page, so this is
  // delegated off document rather than bound to the headers directly.
  function partsFrom(target){
    var head = target.closest ? target.closest('#brk-og-footer .footer_links_header') : null;
    if (!head) return null;
    var group = head.closest('.footer_links');
    var list  = group && group.querySelector('.footer_link-list');
    return list ? {head:head, list:list} : null;
  }

  function close(p){
    p.head.classList.remove('is-open');
    p.head.setAttribute('aria-expanded','false');
    p.list.style.height = p.list.scrollHeight + 'px';
    requestAnimationFrame(function(){ p.list.style.height = '0px'; });
  }
  function open(p){
    p.head.classList.add('is-open');
    p.head.setAttribute('aria-expanded','true');
    p.list.style.height = p.list.scrollHeight + 'px';
    // once expanded, let it size itself so the links can reflow
    setTimeout(function(){ if (p.head.classList.contains('is-open')) p.list.style.height = 'auto'; }, 420);
  }
  function toggle(p){
    if (!MQ.matches) return;                 // desktop: the lists are always expanded
    p.head.classList.contains('is-open') ? close(p) : open(p);
  }

  document.addEventListener('click', function(e){
    var p = partsFrom(e.target);
    if (p) toggle(p);
  });

  document.addEventListener('keydown', function(e){
    if (e.key !== 'Enter' && e.key !== ' ') return;
    var p = partsFrom(e.target);
    if (!p) return;
    e.preventDefault();
    toggle(p);
  });

  // keep the headers reachable by keyboard as they appear
  function markup(){
    Array.prototype.forEach.call(
      document.querySelectorAll('#brk-og-footer .footer_links_header:not([data-brk-accordion])'),
      function(h){
        h.dataset.brkAccordion = '1';
        h.setAttribute('role','button');
        h.setAttribute('tabindex','0');
        h.setAttribute('aria-expanded', h.classList.contains('is-open') ? 'true' : 'false');
      }
    );
  }
  new MutationObserver(markup).observe(document.documentElement, {childList:true, subtree:true});
  markup();

  // crossing the breakpoint: drop any inline height so the desktop layout is clean
  MQ.addEventListener('change', function(){
    Array.prototype.forEach.call(document.querySelectorAll('#brk-og-footer .footer_links'), function(g){
      var head = g.querySelector('.footer_links_header');
      var list = g.querySelector('.footer_link-list');
      if (!head || !list) return;
      head.classList.remove('is-open');
      head.setAttribute('aria-expanded','false');
      list.style.height = '';
    });
  });
})();
</script>
