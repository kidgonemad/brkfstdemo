    var rot = { x: 0.25, y: 0 };
    var autoRotateDir = 1;
    var mouseNDC = { x: 0, y: 0 };
    var mouseInside = false;
    var hoverNDCx = 0;
    var raycaster = new THREE.Raycaster();
    var rayVec = new THREE.Vector2();
