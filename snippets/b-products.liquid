<script id="brk-adbar-js">
(function(){
  var MESSAGES = [
    'Welcome 2 BRKFST',
    'Store Nigeria Opening',
    '10% Discount At Checkout'
  ];

  function unit(text){
    return '<span class="brk-adbar_item">' + text + '</span>' +
           '<span class="brk-adbar_dot" aria-hidden="true"></span>';
  }

  function build(){
    var bar = document.querySelector('.brk-adbar');
    var track = bar && bar.querySelector('.brk-adbar_track');
    if (!track) return;

    var group = document.createElement('div');
    group.className = 'brk-adbar_group';
    track.innerHTML = '';
    track.appendChild(group);

    // Cycle the messages until the group spans the viewport, then keep going to
    // a whole multiple of the set - otherwise the sequence jumps at the loop point.
    var i = 0;
    do {
      group.insertAdjacentHTML('beforeend', unit(MESSAGES[i % MESSAGES.length]));
      i++;
    } while ((group.getBoundingClientRect().width < window.innerWidth || i % MESSAGES.length !== 0)
             && i < 30);

    // second identical group is what makes the -50% loop seamless
    var clone = group.cloneNode(true);
    clone.setAttribute('aria-hidden','true');
    track.appendChild(clone);
  }

  var t;
  window.addEventListener('resize', function(){ clearTimeout(t); t = setTimeout(build, 200); });
  document.addEventListener('DOMContentLoaded', build);
  build();
})();
</script>
