<script>
  // ============================================
  // PAGE TRANSITIONS
  // ============================================
  document.addEventListener('DOMContentLoaded', () => {
    const overlay = document.querySelector('.page-transition');
    const content = document.querySelector('.page-content');

    // Make content visible now that GSAP is ready (no flicker)
    gsap.set(content, { opacity: 1, visibility: 'visible' });
    // Position overlay covering the screen
    gsap.set(overlay, { y: 0 });
    gsap.to(overlay, {
      y: '-100%',
      duration: 0.8,
      delay: 0.5,
      ease: 'power3.inOut'
    });
    // ----- EXIT ANIMATION (runs before navigating away) -----
    const handleLinkClick = (e) => {
      const link = e.currentTarget;
      const href = link.getAttribute('href');
      // Bail out if it's not a real navigation
      if (
        !href ||
        href.startsWith('#') ||                          // anchor link
        href.startsWith('mailto:') ||                    // email
        href.startsWith('tel:') ||                       // phone
        link.target === '_blank' ||                      // new tab
        link.hasAttribute('download') ||                 // download
        e.metaKey || e.ctrlKey || e.shiftKey             // user opening in new tab
      ) {
        return;
      }
      // Only intercept internal links (same origin)
      const url = new URL(href, window.location.href);
      if (url.origin !== window.location.origin) return;
      e.preventDefault();
      // Animate overlay back in, then navigate
      gsap.set(overlay, { y: '100%' }); // ensure it starts below
      gsap.to(overlay, {
        y: 0,
        duration: 0.6,
        ease: 'power3.inOut',
        onComplete: () => {
          window.location.href = href;
        }
      });
    };
    // Attach to every internal link
    document.querySelectorAll('a[href]').forEach(link => {
      link.addEventListener('click', handleLinkClick);
    });
    // ----- BFCACHE FIX -----
    // When user hits back button, browser may restore the page with
    // the overlay still covering it. Re-run the reveal in that case.
    window.addEventListener('pageshow', (e) => {
      if (e.persisted) {
        gsap.set(overlay, { y: 0 });
        gsap.to(overlay, {
          y: '-100%',
          duration: 0.8,
          delay: 0.5,
          ease: 'power3.inOut'
        });
      }
    });
  });
</script><script src="{{ 'wf_6a229697fcb91dd168682307_689e5ba67671442434f3ca35_6a229697fcb91dd168682317_footer_accordion-1.0.0.js' | asset_url }}" type="text/javascript"></script><style id="brk-cat-filter-css">.brk-cat-hidden{display:none !important}</style>
<script id="brk-cat-filter">
/* ?cat=<category> turns /products into that category's page: the hero title
   becomes the category, its products lead the page, and everything else is
   gathered under "More Products" below rather than hidden -- so no product
   becomes unreachable from a filtered view.

   With no ?cat the page renders exactly as authored, so "all products" stays
   the default and nothing depends on JS running. Cards carry a space
   separated list, because the CSV accessories are also new arrivals. */
(function () {
  var LABELS = {new: "New Arrivals", classics: "Classics",
                accessories: "Accessories"};
  var cat = (new URLSearchParams(location.search).get("cat") || "").toLowerCase();
  if (!LABELS[cat]) return;

  var cards = [].slice.call(document.querySelectorAll("[data-brk-cat]"));
  if (!cards.length) return;

  var match = [], rest = [];
  cards.forEach(function (card) {
    var cats = (card.getAttribute("data-brk-cat") || "").toLowerCase().split(/\s+/);
    (cats.indexOf(cat) === -1 ? rest : match).push(card);
  });

  /* The two product sections in document order. The first becomes the
     category, the second becomes the remainder -- rather than cloning a
     section, which would duplicate the grid's markup and its scripts. */
  var sections = [].slice.call(document.querySelectorAll("section"))
    .filter(function (sec) { return sec.querySelector("[data-brk-cat]"); });
  if (sections.length < 2) return;

  function fill(sec, list, label) {
    var grid = sec.querySelector(".cl_shop-listing_list");
    if (!grid) return;
    list.forEach(function (card) { grid.appendChild(card); });   /* moves, not copies */
    sec.classList.toggle("brk-cat-hidden", list.length === 0);

    var title = sec.querySelector(".brk-sec-title");
    if (title) title.textContent = label;
    /* The section's own "Shop X" link pointed back at the view you are
       already in, and after the retitle it would contradict the heading. */
    var link = sec.querySelector(".brk-sec-link");
    if (link) link.remove();
  }

  fill(sections[0], match, LABELS[cat]);
  fill(sections[sections.length - 1], rest, "More Products");

  /* The hero still read "BRKFST X SHOP" on every category, which is the main
     reason a filtered view felt like the same page you started on. */
  var hero = document.querySelector(".brk-hero_title");
  if (hero) hero.textContent = LABELS[cat].toUpperCase();

  document.title = LABELS[cat] + " \u2014 BRKFST";
})();
