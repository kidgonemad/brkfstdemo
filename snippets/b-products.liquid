<script id="brk-card-meta-js">
(function(){
  // Every product is Limited Edition by default; anything listed in CHIPS uses
  // that instead. Values are any of: limited, classics, restocked, soldout.
  var DEFAULT_CHIPS = ['limited'];
  var CHIPS = {
    'brkfst-white-classic-tee': ['classics'],
    'brkfst-black-classic-tee': ['classics']
  };

  var LABEL = {limited:'Limited Stock', classics:'Classics',
               restocked:'Restocked', soldout:'Sold Out'};

  function slug(href){
    var m = (href||'').match(/\/products\/([^/?#]+)/);
    return m ? m[1] : null;
  }

  function decorate(card){
    if (card.dataset.brkMeta) return;
    card.dataset.brkMeta = '1';

    // one-line description; its overflow scrolls on hover instead of wrapping
    var desc = card.querySelector('.product-card_description p');
    if (desc && !desc.querySelector('.brk-desc-scroll')){
      desc.classList.add('product-card_drop');
      var span = document.createElement('span');
      span.className = 'brk-desc-scroll';
      span.textContent = desc.textContent;
      desc.textContent = '';
      desc.appendChild(span);
      measure(desc, span);
    }

    var keys = CHIPS[slug(card.getAttribute('href'))] || DEFAULT_CHIPS;
    if (!keys || !keys.length) return;
    var wrap = card.querySelector('.product-card_thumbnail_wrapper');
    if (!wrap || wrap.querySelector('.brk-chips')) return;

    var box = document.createElement('div');
    box.className = 'brk-chips';
    keys.forEach(function(k){
      if (!LABEL[k]) return;
      var chip = document.createElement('span');
      chip.className = 'brk-chip is-' + k;
      chip.textContent = LABEL[k];
      box.appendChild(chip);
    });
    wrap.appendChild(box);
    reveal(box);
  }

  // Reveal each chip box once, when its card scrolls into view. Falls back to
  // showing them immediately where IntersectionObserver isn't available.
  var io = ('IntersectionObserver' in window) ? new IntersectionObserver(function(entries){
    entries.forEach(function(e){
      if (!e.isIntersecting) return;
      Array.prototype.forEach.call(e.target.querySelectorAll('.brk-chip'), function(chip, i){
        chip.style.setProperty('--delay', (i * 0.12) + 's');   // stagger the second chip
        chip.classList.add('is-in');
      });
      io.unobserve(e.target);
    });
  }, {threshold:0.25}) : null;

  function reveal(box){
    if (!io){
      Array.prototype.forEach.call(box.querySelectorAll('.brk-chip'), function(c){ c.classList.add('is-in'); });
      return;
    }
    io.observe(box);
  }


  // How far the text runs past the visible line, and how long it should take.
  // Deferred to rAF because width is 0 until the card has laid out.
  function measure(desc, span){
    requestAnimationFrame(function(){
      var shift = span.scrollWidth - desc.clientWidth;
      if (shift > 4){
        desc.classList.add('is-over');
        desc.style.setProperty('--shift', shift + 'px');
        desc.style.setProperty('--dur', Math.max(3, shift / 28) + 's');  // steady reading pace
      } else {
        desc.classList.remove('is-over');
      }
    });
  }

  // widths change with the viewport, so re-measure on resize
  var rt;
  window.addEventListener('resize', function(){
    clearTimeout(rt);
    rt = setTimeout(function(){
      Array.prototype.forEach.call(document.querySelectorAll('.product-card_drop'), function(desc){
        var span = desc.querySelector('.brk-desc-scroll');
        if (span) measure(desc, span);
      });
    }, 200);
  });

  function run(){
    Array.prototype.forEach.call(document.querySelectorAll('a.product-card'), decorate);
  }

  // the grid is rendered client-side and re-rendered on filter changes
  new MutationObserver(run).observe(document.documentElement, {childList:true, subtree:true});
  document.addEventListener('DOMContentLoaded', run);
  run();
})();
</script>
