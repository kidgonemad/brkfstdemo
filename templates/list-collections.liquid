{% capture brk_head %}{% render 'h-products' %}{% endcapture %}
{% capture brk_html_attrs %} data-wf-domain="www.shopbrkfst.com" data-wf-page="6a229697fcb91dd16868232e" data-wf-site="6a229697fcb91dd168682307" lang="en"{% endcapture %}
{% capture brk_body_attrs %} {% endcapture %}
{% render 'b-products' %}

<script>window.BRK_COLLECTION={handle:{{ collection.handle | json }},title:{{ collection.title | json }},handles:[{% for product in collection.products %}{{ product.handle | json }}{% unless forloop.last %},{% endunless %}{% endfor %}]};</script>
<script>
(function(){
  function apply(){
    var C=window.BRK_COLLECTION||{};
    var all=!C.handle||C.handle==='all'||C.handle==='frontpage';
    if(all)return;   /* main shop page: keep BRKFST X SHOP / New Arrivals untouched */
    var title=C.title||'All Products';
    var t=document.querySelector('.brk-hero_title');if(t)t.textContent=title.toUpperCase();
    var st=document.querySelector('.brk-sec-title');if(st)st.textContent=title;
    document.title='BRKFST \u2014 '+title;
    var set={};(C.handles||[]).forEach(function(h){set[h]=1});
    document.querySelectorAll('.cl_shop-listing_item').forEach(function(it){
      var a=it.querySelector('a[href^="/products/"]');
      var h=a&&a.getAttribute('href').split('/')[2];
      if(!h||!set[h])it.style.display='none';
    });
    if(C.handle!=='classics'){var cs=document.querySelector('.brk-shop-classics');if(cs)cs.style.display='none';}
    else{var na=document.querySelector('.section_default.is-overflow-hidden');if(na)na.style.display='none';}
    var bb=document.querySelector('.brk-band');if(bb)bb.style.display='none';
  }
  if(document.readyState!=='loading')apply();
  else document.addEventListener('DOMContentLoaded',apply);
})();
</script>
