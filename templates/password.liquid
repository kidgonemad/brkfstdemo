{% layout none %}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ shop.name }} — ENTER PASSCODE</title>

{%- comment -%}
  This page is {% layout none %} with its own <head>, so it does not inherit the
  favicon the h-*.liquid head snippets add to every other page. Without these the
  passcode screen is the one page showing a blank browser tab icon.
{%- endcomment -%}
<link rel="shortcut icon" href="{{ 'brkfst-merch_favicon-b-dark.png' | asset_url }}" type="image/png">
<link rel="icon" href="{{ 'brkfst-merch_favicon-b-dark.png' | asset_url }}" type="image/png" sizes="32x32" media="(prefers-color-scheme: light)">
<link rel="icon" href="{{ 'brkfst-merch_favicon-b-light.png' | asset_url }}" type="image/png" sizes="32x32" media="(prefers-color-scheme: dark)">
<link rel="icon" href="{{ 'brkfst-merch_favicon-b-dark.png' | asset_url }}" type="image/png" sizes="48x48">
<link rel="icon" href="{{ 'brkfst-merch_favicon-b-dark.png' | asset_url }}" type="image/png" sizes="192x192">
<link rel="apple-touch-icon" href="{{ 'brkfst-merch_favicon-b-dark.png' | asset_url }}" sizes="180x180">
<style>
  @font-face{font-family:'Hubot Sans Condensed Bold';
    src:url('{{ 'hubot-sans-condensed-bold.woff2' | asset_url }}') format('woff2');
    font-weight:700;font-style:normal;font-display:block}
  :root{--paper:#fdfdfd;--ink:#000;--brk-orange:#ff6600}
  *{box-sizing:border-box;margin:0;padding:0}
  html,body{height:100%}
  body{background:var(--paper);color:var(--ink);
    font-family:'Hubot Sans Condensed Bold',Arial,sans-serif;font-weight:700;
    display:flex;flex-direction:column;min-height:100vh;
    text-rendering:optimizeLegibility;-webkit-font-smoothing:antialiased}

  /* full-screen doodle camo, traced from outlinecamo.png, scaled to cover */
  .camo{position:fixed;inset:0;z-index:0;pointer-events:none;
    background:var(--paper) url('{{ 'brk-camo-pattern.svg' | asset_url }}') center center / cover no-repeat}

  /* ---- eyes: pupils blink in place; the traced camo itself is untouched ----
     Each pair shares one --bd/--bdl, so the two eyes of a face blink together. */
  .bk-eyes{position:fixed;inset:0;width:100%;height:100%;z-index:1;pointer-events:none}
  .bke-p{fill:var(--ink);transform-origin:0 0;   /* pupil is centred on its own 0,0 */
    animation:bkblink var(--bd,6s) var(--bdl,0s) infinite ease-in-out}
  @keyframes bkblink{0%,93%,100%{transform:scaleY(1)}96.5%{transform:scaleY(.08)}}
  @media(prefers-reduced-motion:reduce){.bke-p{animation:none}}

  /* ---- orange highlight: each plate is swept on like a marker stroke ---- */
  .st>span,.err,.field,.legal{
    background-image:linear-gradient(var(--brk-orange),var(--brk-orange));
    background-repeat:no-repeat;
    background-position:left center;
    background-size:0% 100%;
    animation:brkhl .5s cubic-bezier(.25,.8,.3,1) var(--hl,0s) forwards}
  @keyframes brkhl{from{background-size:0% 100%}to{background-size:100% 100%}}
  /* staggered top -> bottom, so the page marks itself up in sequence */
  .clocks .st:nth-child(1)>span{--hl:.10s}
  .clocks .st:nth-child(2)>span{--hl:.20s}
  .clocks .st:nth-child(3)>span{--hl:.30s}
  .clocks .st>span+span{--hl:.38s}
  .err{--hl:.42s}
  .field{--hl:.52s}
  .legal{--hl:.74s}
  @media(prefers-reduced-motion:reduce){
    .st>span,.err,.field,.legal{animation:none;background-size:100% 100%}}

  .corner{position:fixed;width:14px;height:14px;border:0 solid var(--ink);z-index:5}
  .corner.tl{top:14px;left:14px;border-top-width:1px;border-left-width:1px}
  .corner.tr{top:14px;right:14px;border-top-width:1px;border-right-width:1px}
  .corner.bl{bottom:14px;left:14px;border-bottom-width:1px;border-left-width:1px}
  .corner.br{bottom:14px;right:14px;border-bottom-width:1px;border-right-width:1px}

  .clocks{position:relative;z-index:2;
    display:grid;grid-template-columns:1fr 1fr 1fr;gap:1rem;
    padding:2rem 2.4rem 0;font-size:.82rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase}
  .st{display:flex;flex-direction:column;gap:.35rem}
  .st:nth-child(1){align-items:flex-start;text-align:left}
  .st:nth-child(2){align-items:center;text-align:center}
  .st:nth-child(3){align-items:flex-end;text-align:right}
  /* orange plate behind each clock block so it reads over the camo */
  .st span{color:var(--ink);padding:.18em .4em;display:inline-block}
  .st .time{font-weight:800;font-variant-numeric:tabular-nums}
  .st .time .cln{animation:brkblink 1s steps(1) infinite}
  @keyframes brkblink{50%{opacity:0}}

  main{position:relative;z-index:2;
    flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;
    gap:3.2rem;padding:2rem;text-align:center}
  .logo svg{height:clamp(90px,16vw,150px);width:auto;display:block}
  form{width:100%;display:flex;flex-direction:column;align-items:center;gap:1rem}
  .err{font-size:.75rem;letter-spacing:.18em;color:var(--ink);padding:.35em .7em}
  /* orange plate sized to the field so the passcode line matches the mock */
  .field{display:inline-block;padding:.1em .5em}
  input#pass{width:min(88vw,16ch);background:transparent;border:0;color:var(--ink);text-align:center;
    font-family:inherit;font-weight:800;font-size:clamp(2.2rem,7.5vw,3.8rem);
    letter-spacing:.02em;text-transform:uppercase;caret-color:var(--ink);display:block}
  input#pass::placeholder{color:var(--ink);opacity:1}
  input#pass:focus{outline:none}
  input#pass:focus::placeholder{opacity:.45}

  footer{position:relative;z-index:2;padding:0 2.4rem 1.6rem;text-align:center;
    display:flex;flex-direction:column;align-items:center;gap:.5rem}
  .legal{font-size:.8rem;line-height:1.75;font-weight:700;letter-spacing:.03em;
    text-transform:uppercase;word-spacing:.4em;
    color:var(--ink);padding:.3em .8em;display:inline-block}
  @media(max-width:560px){.clocks{font-size:.62rem;padding:1.4rem 1.2rem 0}
    footer{padding:0 1.2rem 1.2rem}.legal{font-size:.6rem}}

  /* ---- Klaviyo email capture ---- */
  .nl{position:fixed;inset:0;z-index:20;display:flex;align-items:center;justify-content:center;padding:1.5rem}
  .nl[hidden]{display:none}
  .nl-veil{position:absolute;inset:0;background:rgba(0,0,0,.55);animation:nlfade .25s ease both}
  @keyframes nlfade{from{opacity:0}to{opacity:1}}

  /* the panel itself carries no paint - the reticle and the fill do,
     so the corner ticks can open out before anything else appears */
  .nl-panel{position:relative;color:var(--ink);
    width:min(92vw,430px);padding:2.1rem 1.9rem 1.7rem}
  .nl-fill{position:absolute;inset:0;background:var(--paper);
    box-shadow:0 18px 60px rgba(0,0,0,.35);
    animation:nlfill .18s ease .30s both}
  @keyframes nlfill{from{opacity:0}to{opacity:1}}

  /* reticle: starts as a small square in the middle, opens to the panel edges */
  .nl-frame{position:absolute;pointer-events:none;z-index:2;
    animation:nlopen .40s cubic-bezier(.2,.85,.25,1) both}
  @keyframes nlopen{
    from{inset:calc(50% - 30px) calc(50% - 30px)}
    to{inset:5px}}
  .nl-c{position:absolute;width:19px;height:19px;border:0 solid var(--ink)}
  .nl-c.tl{top:0;left:0;border-top-width:1px;border-left-width:1px}
  .nl-c.tr{top:0;right:0;border-top-width:1px;border-right-width:1px}
  .nl-c.bl{bottom:0;left:0;border-bottom-width:1px;border-left-width:1px}
  .nl-c.br{bottom:0;right:0;border-bottom-width:1px;border-right-width:1px}

  .nl-body{position:relative;z-index:1}
  .nl-form,.nl-x{animation:nlfade .3s ease .62s both}
  .nl-x{position:absolute;top:10px;right:10px;background:none;border:0;color:var(--ink);
    cursor:pointer;padding:6px;line-height:0}
  .nl-x:hover{color:var(--brk-orange)}
  .nl-h{font-size:clamp(1.5rem,5vw,2rem);letter-spacing:.01em;text-transform:uppercase;
    background-image:linear-gradient(var(--brk-orange),var(--brk-orange));
    background-repeat:no-repeat;background-size:0% 100%;background-position:left center;
    display:inline;box-decoration-break:clone;-webkit-box-decoration-break:clone;padding:.05em .25em;
    /* sweeps once the decoded text has settled */
    animation:brkhl .45s cubic-bezier(.25,.8,.3,1) .78s both}
  .nl-b{font-size:.8rem;line-height:1.6;letter-spacing:.04em;text-transform:uppercase;
    opacity:.72;margin:.95rem 0 1.25rem}
  .nl-form{display:flex;flex-direction:column;gap:.55rem}
  .nl-lab{font-size:.62rem;letter-spacing:.18em;text-transform:uppercase;opacity:.6}
  .nl-in{font-family:inherit;font-weight:700;font-size:1rem;letter-spacing:.02em;
    padding:.72rem .8rem;border:1px solid var(--ink);background:transparent;color:var(--ink);width:100%}
  .nl-in::placeholder{color:var(--ink);opacity:.32;text-transform:none}
  .nl-in:focus{outline:none;border-color:var(--brk-orange);box-shadow:inset 0 0 0 1px var(--brk-orange)}
  .nl-in[aria-invalid="true"]{border-color:#c00;box-shadow:inset 0 0 0 1px #c00}
  .nl-go{font-family:inherit;font-weight:800;font-size:.9rem;letter-spacing:.12em;
    padding:.78rem 1rem;border:0;background:var(--brk-orange);color:var(--ink);cursor:pointer;
    text-transform:uppercase;transition:filter .15s ease}
  .nl-go:hover{filter:brightness(1.08)}
  .nl-go[disabled]{opacity:.55;cursor:default}
  .nl-msg{font-size:.68rem;letter-spacing:.1em;text-transform:uppercase;min-height:1em;margin-top:.15rem}
  .nl-msg.err{color:#c00}
  .nl-msg.ok{color:var(--ink);background:var(--brk-orange);display:inline-block;padding:.25em .5em}
  @media(prefers-reduced-motion:reduce){
    .nl-veil,.nl-fill,.nl-form,.nl-x{animation:none}
    .nl-frame{animation:none;inset:5px}
    .nl-h{animation:none;background-size:100% 100%}}
</style>
</head>
<body>
<div class="camo" aria-hidden="true"></div>
{% render 'brk-camo-eyes' %}

<span class="corner tl"></span><span class="corner tr"></span>
<span class="corner bl"></span><span class="corner br"></span>

<div class="clocks" aria-hidden="true">
  <div class="st"><span>New York, USA</span><span class="time" data-tz="America/New_York">--&nbsp;--</span></div>
  <div class="st"><span>Paris, FR</span><span class="time" data-tz="Europe/Paris">--&nbsp;--</span></div>
  <div class="st"><span>Lagos, NGA</span><span class="time" data-tz="Africa/Lagos">--&nbsp;--</span></div>
</div>

<main>
  <div class="logo">
    <svg viewBox="0 0 353 140" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="B">
      <path fill="#000" fill-rule="evenodd" d="M62 0 314 0 337 4 347 9 353 17 353 28 349 38 335 52 316 62 292 69 315 77 323 84 325 88 325 100 321 110 309 123 307 123 303 127 278 137 256 140 153 140 155 134 161 127 162 123 166 119 173 106 232 106 249 105 261 101 265 95 265 92 258 87 186 85 188 84 189 80 191 79 203 59 209 54 272 53 284 47 286 42 285 38 277 35 37 35 56 3 62 0Z M93 46 135 46 135 49 133 50 130 57 122 67 121 71 113 81 112 85 104 95 103 99 95 109 94 113 86 123 85 127 76 138 71 140 29 139 29 137 65 85 73 70 81 60 84 53 93 46Z M155 46 196 46 196 48 194 49 193 53 187 60 186 64 182 68 181 72 175 79 174 83 168 90 167 94 161 101 160 105 154 112 153 116 149 120 148 124 146 125 138 139 90 140 90 137 104 118 105 114 121 92 122 88 138 66 145 53 150 48 155 46Z"/>
    </svg>
  </div>
  {% form 'storefront_password' %}
    {% if form.errors %}<div class="err">WRONG PASSCODE — TRY AGAIN</div>{% endif %}
    <span class="field">
      <input id="pass" type="password" name="password" placeholder="ENTER PASSCODE"
             autocomplete="current-password" aria-label="Passcode" autofocus>
    </span>
  {% endform %}
</main>

{% render 'brk-klaviyo-popup' %}

<footer>
  <p class="legal">&copy; 2022 BRKFST CLOTHING. ALL RIGHTS RESERVED. PRODUCED BY BRKFST.
  MADE B4 NOON. UNAUTHORIZED ACCESS, REPRODUCTION, OR MODIFICATION IS PROHIBITED. NON-TRANSFERABLE.</p>
</footer>

<script>
/* brk_heal_v1: same one-time cleanup as layout/theme.liquid - this template is
   layout none, so it needs its own copy (the password page is most visitors'
   first hit, making it the most important place for the heal to run) */
try{if(localStorage.getItem('brk_heal_v1')!=='1'){
  ['brk-theme','brk-store-theme','brk-elem-theme','brk-tp-hidden','brk-shop-layout','WebflowEditor']
    .forEach(function(k){try{localStorage.removeItem(k)}catch(e){}});
  if(navigator.serviceWorker&&navigator.serviceWorker.getRegistrations)
    navigator.serviceWorker.getRegistrations()
      .then(function(rs){rs.forEach(function(r){r.unregister()})}).catch(function(){});
  localStorage.setItem('brk_heal_v1','1');
}}catch(e){}
(function(){
  var els=document.querySelectorAll('[data-tz]');
  function offset(tz){
    try{
      var p=new Intl.DateTimeFormat('en-US',{timeZone:tz,timeZoneName:'shortOffset'})
        .formatToParts(new Date()).find(function(x){return x.type==='timeZoneName';});
      return p?p.value:'';
    }catch(e){return '';}
  }
  function tick(){
    els.forEach(function(el){
      var tz=el.getAttribute('data-tz');
      try{
        var t=new Intl.DateTimeFormat('en-GB',{timeZone:tz,hour:'2-digit',minute:'2-digit',hour12:false})
          .format(new Date()).split(':');
        el.innerHTML=t[0]+'<span class="cln">:</span>'+t[1]+' '+offset(tz);
      }catch(e){}
    });
  }
  tick();setInterval(tick,1000);
  /* type anywhere to jump into the passcode field - but never steal focus
     from another field (the email popup) or while that popup is open */
  var inp=document.getElementById('pass');
  if(inp)document.addEventListener('keydown',function(e){
    if(document.activeElement===inp) return;
    var t=document.activeElement, tag=t&&t.tagName;
    if(tag==='INPUT'||tag==='TEXTAREA'||tag==='BUTTON'||(t&&t.isContentEditable)) return;
    var nl=document.getElementById('nl');
    if(nl&&!nl.hidden) return;
    if(e.key.length===1) inp.focus();
  });
})();

/* ---- Klaviyo email capture -------------------------------------------
   Posts to Klaviyo's client-side Subscriptions API, which authenticates
   with the PUBLIC key only. Opens once per visitor; a dismissal or a
   successful sign-up is remembered in localStorage.
   -------------------------------------------------------------------- */
(function(){
  var nl=document.getElementById('nl'); if(!nl) return;
  var KEY=nl.dataset.key, LIST=nl.dataset.list;
  var DELAY=(parseFloat(nl.dataset.delay)||0)*1000;
  var SEEN='brk_nl_v1';
  var REVISION='2024-10-15';        // pinned Klaviyo API revision

  function seen(){ try{return localStorage.getItem(SEEN)==='1';}catch(e){return false;} }
  function remember(){ try{localStorage.setItem(SEEN,'1');}catch(e){} }

  var pass=document.getElementById('pass');
  var email=nl.querySelector('.nl-in');
  var form=nl.querySelector('.nl-form');
  var btn=nl.querySelector('.nl-go');
  var msg=nl.querySelector('.nl-msg');
  var lastFocus=null;

  /* matrix decode: characters resolve left to right out of random glyphs.
     Spaces are left intact so the word shape is readable throughout. */
  var GLYPH='ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789/\\|<>#*+=-';
  var reduce=false;
  try{ reduce=matchMedia('(prefers-reduced-motion:reduce)').matches; }catch(e){}

  function scramble(el,dur,delay){
    var full=el.dataset.text||(el.dataset.text=el.textContent);
    if(reduce){ el.textContent=full; return; }
    el.textContent='';
    /* safety net: rAF is throttled in background tabs, so guarantee the real
       text is restored even if the animation never gets to run */
    clearTimeout(el._brkSafe);
    el._brkSafe=setTimeout(function(){ el.textContent=full; }, delay+dur+800);
    var t0=null, raf=null;
    function frame(ts){
      if(t0===null) t0=ts;
      var p=(ts-t0-delay)/dur;
      if(p<0){ raf=requestAnimationFrame(frame); return; }
      if(p>=1){ el.textContent=full; clearTimeout(el._brkSafe); return; }
      var lit=Math.floor(full.length*p), out='';
      for(var i=0;i<full.length;i++){
        var c=full[i];
        if(c===' '||c==='\n'){ out+=c; }
        else if(i<lit){ out+=c; }
        else{ out+=GLYPH[(Math.random()*GLYPH.length)|0]; }
      }
      el.textContent=out;
      raf=requestAnimationFrame(frame);
    }
    raf=requestAnimationFrame(frame);
    el._brkStop=function(){ if(raf) cancelAnimationFrame(raf);
                            clearTimeout(el._brkSafe); el.textContent=full; };
  }

  function runIntro(){
    Array.prototype.forEach.call(nl.querySelectorAll('[data-scramble]'),function(el,i){
      if(el._brkStop) el._brkStop();
      scramble(el, i===0?460:430, i===0?400:520);   /* after the reticle lands */
    });
  }

  function open(){
    if(!nl.hidden) return;
    lastFocus=document.activeElement;
    nl.hidden=false;
    runIntro();
    setTimeout(function(){ try{email.focus();}catch(e){} }, reduce?30:640);
  }
  function close(){
    if(nl.hidden) return;
    nl.hidden=true; remember();
    try{ (lastFocus===email?pass:lastFocus||pass).focus(); }catch(e){}
  }

  Array.prototype.forEach.call(nl.querySelectorAll('[data-nl-close]'),function(el){
    el.addEventListener('click',close);
  });
  document.addEventListener('keydown',function(e){
    if(e.key==='Escape'&&!nl.hidden) close();
  });
  /* keep tabbing inside the dialog while it is open */
  nl.addEventListener('keydown',function(e){
    if(e.key!=='Tab') return;
    var f=nl.querySelectorAll('button,input');
    if(!f.length) return;
    var first=f[0], last=f[f.length-1];
    if(e.shiftKey&&document.activeElement===first){ e.preventDefault(); last.focus(); }
    else if(!e.shiftKey&&document.activeElement===last){ e.preventDefault(); first.focus(); }
  });

  function say(text,cls){ msg.textContent=text; msg.className='nl-msg'+(cls?' '+cls:''); }

  form.addEventListener('submit',function(e){
    e.preventDefault();
    var v=(email.value||'').trim();
    if(!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v)){
      email.setAttribute('aria-invalid','true');
      say('Enter a valid email address','err'); email.focus(); return;
    }
    email.removeAttribute('aria-invalid');
    btn.disabled=true; say('Sending…');

    /* With a list ID we subscribe (consent recorded, campaign-ready).
       Without one we still create the profile in Klaviyo, so no email is
       ever lost while the ID is being tracked down. */
    var url,payload;
    if(LIST){
      /* Posting to /client/subscriptions/ IS the opt-in, so no explicit
         consent block is sent - the endpoint rejects `subscriptions` inside
         the profile, and the list's own single/double opt-in setting governs. */
      url='https://a.klaviyo.com/client/subscriptions/?company_id='+encodeURIComponent(KEY);
      payload={data:{type:'subscription',
        attributes:{
          custom_source:'Password page',
          profile:{data:{type:'profile',attributes:{email:v}}}
        },
        relationships:{list:{data:{type:'list',id:LIST}}}}};
    }else{
      url='https://a.klaviyo.com/client/profiles/?company_id='+encodeURIComponent(KEY);
      payload={data:{type:'profile',attributes:{email:v}}};
    }

    fetch(url,{
      method:'POST',
      headers:{'content-type':'application/json','revision':REVISION},
      body:JSON.stringify(payload)
    }).then(function(r){
      if(r.status===202||r.ok){
        say('You are in — check your inbox','ok');
        form.querySelector('.nl-lab').hidden=true;
        email.hidden=true; btn.hidden=true;
        remember();
        setTimeout(close,2200);
      }else{
        return r.text().then(function(t){
          /* pull Klaviyo's own explanation out of the JSON:API error body */
          var detail=t;
          try{
            var j=JSON.parse(t);
            if(j.errors&&j.errors.length){
              detail=j.errors.map(function(e){
                return (e.detail||e.title||'')+
                       (e.source&&e.source.pointer?' ['+e.source.pointer+']':'');
              }).join(' | ');
            }
          }catch(_){}
          var er=new Error(r.status+' '+detail);
          er.status=r.status; er.detail=detail;
          throw er;
        });
      }
    }).catch(function(err){
      btn.disabled=false;
      say('Could not sign you up — try again','err');
      if(window.console) console.warn('[BRKFST] Klaviyo subscribe failed:',err);
      /* add ?nldebug=1 to the URL to see the real reason on screen */
      if(/[?&]nldebug=1/.test(location.search)){
        var d=document.createElement('p');
        d.className='nl-msg err';
        d.style.cssText='margin-top:.5rem;font-size:.6rem;line-height:1.5;'+
                        'letter-spacing:.04em;text-transform:none;word-break:break-word';
        d.textContent='['+(err.status||'network')+'] '+(err.detail||err.message)+
                      '  •  list='+(LIST||'(none)')+' key='+KEY;
        var prev=form.querySelector('.nl-dbg'); if(prev) prev.remove();
        d.classList.add('nl-dbg'); form.appendChild(d);
      }
    });
  });

  if(!seen()) setTimeout(open,DELAY);
  /* let it be re-opened deliberately even after dismissal */
  Array.prototype.forEach.call(document.querySelectorAll('[data-nl-open]'),function(el){
    el.addEventListener('click',function(e){ e.preventDefault(); open(); });
  });
})();
</script>
</body>
</html>
