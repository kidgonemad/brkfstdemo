{% render 'brk-shell-open' %}
<h1 class="brk-stub-title">CART ({{ cart.item_count }} ITEM{% if cart.item_count != 1 %}S{% endif %})</h1>
{% if cart.item_count == 0 %}
  <p>Your cart is empty.</p>
  <a class="brk-btn" href="/products">SHOP PRODUCTS &#8618;</a>
{% else %}
<form action="/cart" method="post" novalidate>
  <style>
    .brk-cart-line{display:flex;gap:1.25rem;align-items:center;padding:1.1rem 0;border-bottom:1px solid rgba(0,0,0,.15)}
    .brk-cart-line img{width:72px;height:72px;object-fit:contain;background:#F4F4F4}
    .brk-cart-line .t{flex:1}
    .brk-cart-line .t small{opacity:.55;display:block}
    .brk-cart-line input{width:4.2rem;margin:0;text-align:center}
    .brk-cart-sub{display:flex;justify-content:space-between;align-items:center;padding:1.4rem 0;font-weight:500}
  </style>
  {% for item in cart.items %}
  <div class="brk-cart-line">
    {% if item.image %}<img src="{{ item.image | image_url: width: 144 }}" alt="">{% endif %}
    <div class="t">
      <div>{{ item.product.title }}</div>
      {% unless item.variant.title == 'Default Title' %}<small>{{ item.variant.title }}</small>{% endunless %}
      <small>{{ item.final_price | money }}</small>
    </div>
    <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantity">
  </div>
  {% endfor %}
  <div class="brk-cart-sub">
    <span>SUBTOTAL</span><span>{{ cart.total_price | money }}</span>
  </div>
  <button type="submit" name="update" style="background:#0A0A0A;color:#fff">UPDATE</button>
  <button type="submit" name="checkout">CHECKOUT &#8618;</button>
  <p><a href="/products" style="text-decoration:underline">&larr; BACK TO SHOP</a></p>
</form>
{% endif %}
{% render 'brk-shell-close' %}
